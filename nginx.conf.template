server {
  listen 80;
  set $shell_report_proxy_secret "${SHELL_REPORT_PROXY_SHARED_SECRET}";
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  resolver 127.0.0.11 valid=30s ipv6=off;
  proxy_connect_timeout 5s;
  proxy_send_timeout 60s;
  proxy_read_timeout 60s;
  set $dashboard_shell_csp "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'";

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 256;
  gzip_vary on;
  gzip_proxied any;
  gzip_types
    text/plain
    text/css
    text/javascript
    application/javascript
    application/json
    application/xml
    text/xml
    image/svg+xml
    image/x-icon
    font/woff
    font/woff2
    font/ttf
    font/eot;

  location = /index.html {
    etag off;
    if_modified_since off;
    expires -1;
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header Content-Security-Policy $dashboard_shell_csp always;
  }

  location = /modules/aawm-tap/remoteEntry.js {
    set $module_dashboard http://aawm-tap-dashboard:80;
    rewrite ^/modules/aawm-tap/(.*)$ /$1 break;
    include /etc/nginx/modules-proxy.conf;
    add_header Cache-Control "no-store" always;
  }

  location ^~ /modules/aawm-tap/ {
    set $module_dashboard http://aawm-tap-dashboard:80;
    rewrite ^/modules/aawm-tap/(.*)$ /$1 break;
    include /etc/nginx/modules-proxy.conf;
  }

  location = /modules/aawm/remoteEntry.js {
    set $module_dashboard http://aawm-dashboard:80;
    rewrite ^/modules/aawm/(.*)$ /$1 break;
    include /etc/nginx/modules-proxy.conf;
    add_header Cache-Control "no-store" always;
  }

  location ^~ /modules/aawm/ {
    set $module_dashboard http://aawm-dashboard:80;
    rewrite ^/modules/aawm/(.*)$ /$1 break;
    include /etc/nginx/modules-proxy.conf;
  }

  location = /modules/aawm-observe/remoteEntry.js {
    set $module_dashboard http://aawm-observe-dashboard:80;
    rewrite ^/modules/aawm-observe/(.*)$ /$1 break;
    include /etc/nginx/modules-proxy.conf;
    add_header Cache-Control "no-store" always;
  }

  location ^~ /modules/aawm-observe/ {
    set $module_dashboard http://aawm-observe-dashboard:80;
    rewrite ^/modules/aawm-observe/(.*)$ /$1 break;
    include /etc/nginx/modules-proxy.conf;
  }

  location = /modules/aegis/remoteEntry.js {
    set $module_dashboard http://aegis-dashboard:80;
    rewrite ^/modules/aegis/(.*)$ /$1 break;
    include /etc/nginx/modules-proxy.conf;
    add_header Cache-Control "no-store" always;
  }

  location ^~ /modules/aegis/ {
    set $module_dashboard http://aegis-dashboard:80;
    rewrite ^/modules/aegis/(.*)$ /$1 break;
    include /etc/nginx/modules-proxy.conf;
  }

  location = /modules/sluice/remoteEntry.js {
    set $module_dashboard http://sluice-dashboard:80;
    rewrite ^/modules/sluice/(.*)$ /$1 break;
    include /etc/nginx/modules-proxy.conf;
    add_header Cache-Control "no-store" always;
  }

  location ^~ /modules/sluice/ {
    set $module_dashboard http://sluice-dashboard:80;
    rewrite ^/modules/sluice/(.*)$ /$1 break;
    include /etc/nginx/modules-proxy.conf;
  }

  # Identical proxy directives are shared by include. Route-specific upstream/path,
  # cache, and buffering behavior stays explicit below.
  # Bare-path exact blocks (no trailing slash) keep parity across all API prefixes so
  # `/api/foo` and `/api/foo/` both reach the report service.
  location = /api/aawm-tap {
    include /etc/nginx/report-api-credentialled.conf;
  }

  location ^~ /api/aawm-tap/ {
    include /etc/nginx/report-api-credentialled.conf;
  }

  location = /api/aawm-observe {
    include /etc/nginx/report-api-credentialled.conf;
    proxy_buffering off;
  }

  location ^~ /api/aawm-observe/ {
    include /etc/nginx/report-api-credentialled.conf;
    proxy_buffering off;
  }

  location = /api/aawm {
    include /etc/nginx/report-api-credentialled.conf;
    proxy_buffering off;
  }

  location ^~ /api/aawm/ {
    include /etc/nginx/report-api-credentialled.conf;
    proxy_buffering off;
  }

  location = /hook-api {
    include /etc/nginx/report-api-credentialled.conf;
    proxy_buffering off;
  }

  location ^~ /hook-api/ {
    include /etc/nginx/report-api-credentialled.conf;
    proxy_buffering off;
  }

  location = /api/aegis {
    include /etc/nginx/report-api-credentialled.conf;
    proxy_buffering off;
  }

  location ^~ /api/aegis/ {
    include /etc/nginx/report-api-credentialled.conf;
    proxy_buffering off;
  }

  location = /api/shell {
    include /etc/nginx/report-api-uncredentialled.conf;
  }

  location ^~ /api/shell/ {
    include /etc/nginx/report-api-uncredentialled.conf;
  }

  location = /api/sluice {
    include /etc/nginx/report-api-credentialled.conf;
    proxy_buffering off;
  }

  location ^~ /api/sluice/ {
    include /etc/nginx/report-api-credentialled.conf;
    proxy_buffering off;
  }

  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    etag off;
    if_modified_since off;
    expires -1;
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header Content-Security-Policy $dashboard_shell_csp always;
    try_files $uri $uri/ /index.html;
  }
}

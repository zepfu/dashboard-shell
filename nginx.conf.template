server {
  listen 80;
  set $shell_report_proxy_secret "${SHELL_REPORT_PROXY_SHARED_SECRET}";
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  resolver 127.0.0.11 valid=30s ipv6=off;
  proxy_connect_timeout 5s;
  proxy_send_timeout 60s;
  proxy_read_timeout 60s;
  set $dashboard_shell_csp "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'";

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 256;
  gzip_vary on;
  gzip_proxied any;
  gzip_types
    text/plain
    text/css
    text/javascript
    application/javascript
    application/json
    application/xml
    text/xml
    image/svg+xml
    image/x-icon
    font/woff
    font/woff2
    font/ttf
    font/eot;

  location = /index.html {
    etag off;
    if_modified_since off;
    expires -1;
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header Content-Security-Policy $dashboard_shell_csp always;
  }

  location = /modules/aawm-tap/remoteEntry.js {
    set $aawm_tap_dashboard http://aawm-tap-dashboard:80;
    rewrite ^/modules/aawm-tap/(.*)$ /$1 break;
    proxy_pass $aawm_tap_dashboard;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    add_header Cache-Control "no-store" always;
  }

  location ^~ /modules/aawm-tap/ {
    set $aawm_tap_dashboard http://aawm-tap-dashboard:80;
    rewrite ^/modules/aawm-tap/(.*)$ /$1 break;
    proxy_pass $aawm_tap_dashboard;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location = /modules/aawm/remoteEntry.js {
    set $aawm_dashboard http://aawm-dashboard:80;
    rewrite ^/modules/aawm/(.*)$ /$1 break;
    proxy_pass $aawm_dashboard;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    add_header Cache-Control "no-store" always;
  }

  location ^~ /modules/aawm/ {
    set $aawm_dashboard http://aawm-dashboard:80;
    rewrite ^/modules/aawm/(.*)$ /$1 break;
    proxy_pass $aawm_dashboard;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location = /modules/aawm-observe/remoteEntry.js {
    set $aawm_observe_dashboard http://aawm-observe-dashboard:80;
    rewrite ^/modules/aawm-observe/(.*)$ /$1 break;
    proxy_pass $aawm_observe_dashboard;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    add_header Cache-Control "no-store" always;
  }

  location ^~ /modules/aawm-observe/ {
    set $aawm_observe_dashboard http://aawm-observe-dashboard:80;
    rewrite ^/modules/aawm-observe/(.*)$ /$1 break;
    proxy_pass $aawm_observe_dashboard;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location = /modules/aegis/remoteEntry.js {
    set $aegis_dashboard http://aegis-dashboard:80;
    rewrite ^/modules/aegis/(.*)$ /$1 break;
    proxy_pass $aegis_dashboard;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    add_header Cache-Control "no-store" always;
  }

  location ^~ /modules/aegis/ {
    set $aegis_dashboard http://aegis-dashboard:80;
    rewrite ^/modules/aegis/(.*)$ /$1 break;
    proxy_pass $aegis_dashboard;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location = /modules/sluice/remoteEntry.js {
    set $sluice_dashboard http://sluice-dashboard:80;
    rewrite ^/modules/sluice/(.*)$ /$1 break;
    proxy_pass $sluice_dashboard;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    add_header Cache-Control "no-store" always;
  }

  location ^~ /modules/sluice/ {
    set $sluice_dashboard http://sluice-dashboard:80;
    rewrite ^/modules/sluice/(.*)$ /$1 break;
    proxy_pass $sluice_dashboard;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  # Proxy boilerplate is intentionally repeated here for safe, auditable route-by-route
  # configuration. Most routes need per-target header behavior and should stay explicit.
  # Bare-path exact blocks (no trailing slash) keep parity across all API prefixes so
  # `/api/foo` and `/api/foo/` both reach the report service.
  location = /api/aawm-tap {
    proxy_set_header X-Dashboard-Shell-Proxy-Secret $shell_report_proxy_secret;
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location ^~ /api/aawm-tap/ {
    proxy_set_header X-Dashboard-Shell-Proxy-Secret $shell_report_proxy_secret;
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location = /api/aawm-observe {
    proxy_set_header X-Dashboard-Shell-Proxy-Secret $shell_report_proxy_secret;
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_buffering off;
  }

  location ^~ /api/aawm-observe/ {
    proxy_set_header X-Dashboard-Shell-Proxy-Secret $shell_report_proxy_secret;
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_buffering off;
  }

  location = /api/aawm {
    proxy_set_header X-Dashboard-Shell-Proxy-Secret $shell_report_proxy_secret;
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_buffering off;
  }

  location ^~ /api/aawm/ {
    proxy_set_header X-Dashboard-Shell-Proxy-Secret $shell_report_proxy_secret;
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_buffering off;
  }

  location = /hook-api {
    proxy_set_header X-Dashboard-Shell-Proxy-Secret $shell_report_proxy_secret;
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_buffering off;
  }

  location ^~ /hook-api/ {
    proxy_set_header X-Dashboard-Shell-Proxy-Secret $shell_report_proxy_secret;
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_buffering off;
  }

  location = /api/aegis {
    proxy_set_header X-Dashboard-Shell-Proxy-Secret $shell_report_proxy_secret;
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_buffering off;
  }

  location ^~ /api/aegis/ {
    proxy_set_header X-Dashboard-Shell-Proxy-Secret $shell_report_proxy_secret;
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_buffering off;
  }

  location = /api/shell {
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location ^~ /api/shell/ {
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location = /api/sluice {
    proxy_set_header X-Dashboard-Shell-Proxy-Secret $shell_report_proxy_secret;
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_buffering off;
  }

  location ^~ /api/sluice/ {
    proxy_set_header X-Dashboard-Shell-Proxy-Secret $shell_report_proxy_secret;
    set $shell_report_api http://dashboard-shell-reports:3010;
    proxy_pass $shell_report_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_buffering off;
  }

  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    etag off;
    if_modified_since off;
    expires -1;
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header Content-Security-Policy $dashboard_shell_csp always;
    try_files $uri $uri/ /index.html;
  }
}

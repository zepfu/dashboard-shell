FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV SHELL_REPORT_PORT=3010

COPY server/package.json server/pnpm-lock.yaml ./

RUN corepack enable \
  && corepack prepare pnpm@10.30.2 --activate \
  && pnpm install --prod --frozen-lockfile --ignore-scripts

COPY server ./server
COPY scripts/container-error-intake.sh /usr/local/bin/container-error-intake.sh
RUN chmod +x /usr/local/bin/container-error-intake.sh

# Runtime boundary note (D1-446):
# This image intentionally runs as root in the local operator stack.
# Current behavior reads a read-only host Docker JSON log mount and writes repo-local .analysis intake via bind mount.
# This shape is operationally convenient but not hardened for untrusted multi-tenant host deployments.
EXPOSE 3010

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3010/api/shell/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENV SHELL_CONTAINER_NAME=dashboard-shell-reports
ENV SHELL_CONTAINER_ERROR_INTAKE_DIR=/dashboard-shell-analysis
ENTRYPOINT ["/usr/local/bin/container-error-intake.sh"]
CMD ["node", "server/report-service.mjs"]

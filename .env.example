VITE_CLERK_PUBLISHABLE_KEY=
DATABASE_URL=postgresql://aawm:<password>@127.0.0.1:6432/aawm_tristore
AAWM_API_TARGET=http://aawm-api:8000
AAWM_API_KEY=
AAWM_ACCESS_TOKEN=
AAWM_HOOK_API_TARGET=http://aawm-hook-server:8318
AAWM_HOOK_API_KEY=
AAWM_HOOK_ACCESS_TOKEN=
AAWM_OBSERVE_API_TARGET=http://host.docker.internal:34042
AAWM_OBSERVE_API_KEY=
AAWM_OBSERVE_ACCESS_TOKEN=
AAWM_TAP_API_TARGET=http://host.docker.internal:8010
AAWM_TAP_API_KEY=
AAWM_TAP_ACCESS_TOKEN=
AAWM_TAP_ADMIN_CAPABILITY=
AEGIS_API_TARGET=http://aegis-api:8001/api/v1
AEGIS_ACCESS_TOKEN=
# Local-only bootstrap default. Non-local operators must override this value.
AEGIS_DB_PASSWORD=aegis_dev_password
SLUICE_API_TARGET=http://host.docker.internal:8002/api/v1
SLUICE_ACCESS_TOKEN=

# Browser-facing tokens used by compose-wired remotes / report service (leave empty locally).
VITE_API_KEY=
VITE_ACCESS_TOKEN=
VITE_TAP_API_KEY=
VITE_TAP_ACCESS_TOKEN=

# Host port published by the static compose shell (maps to container :80).
DASHBOARD_SHELL_PORT=3005

# Shared secret nginx injects as X-Dashboard-Shell-Proxy-Secret on proxied API routes.
SHELL_REPORT_PROXY_SHARED_SECRET=dashboard-shell-local-proxy-secret

SHELL_REPORT_PORT=3010
SHELL_REPORT_DB_POOL_MAX=4
SHELL_REPORT_DB_CONNECTION_TIMEOUT_MS=5000
SHELL_REPORT_DB_DISABLE_PARALLELISM=true
SHELL_REPORT_SQL_FANOUT_CONCURRENCY=4
SHELL_REPORT_DATABASE_HOST_REWRITE=aawm-pgbouncer
SHELL_REPORT_DATABASE_PORT_REWRITE=6432
SHELL_REPORT_AAWM_PGBOUNCER_DATABASE_URL=postgresql://aawm:<password>@127.0.0.1:6432/pgbouncer
SHELL_REPORT_AEGIS_PGBOUNCER_DATABASE_URL=postgresql://aegis_app:<password>@aegis-pgbouncer:6432/pgbouncer
SHELL_REPORT_HEALTH_DB_CONNECTION_TIMEOUT_MS=1000
SHELL_REPORT_HEALTH_DB_STATEMENT_TIMEOUT_MS=2000
SHELL_REPORT_MV_HEALTH_CACHE_TTL_MS=30000
SHELL_REPORT_REDIS_URL=redis://dashboard-shell-redis:6379
SHELL_REPORT_REDIS_MAXMEMORY=512mb
SHELL_REPORT_CACHE_PREFIX=dashboard-shell:reports
SHELL_REPORT_CACHE_VERSION=v14
SHELL_REPORT_CACHE_STALE_TTL_MS=86400000
SHELL_REPORT_CACHE_LOCK_TTL_MS=1800000
SHELL_REPORT_CACHE_LOCK_WAIT_MS=60000
SHELL_REPORT_CACHE_PREWARM=false
SHELL_REPORT_CACHE_PREWARM_INTERVAL_MS=900000
SHELL_REPORT_CACHE_PREWARM_LOCK_TTL_MS=7200000
SHELL_REPORT_AGENT_SCORE_REASON_RECENT_ROW_LIMIT=10000
SHELL_REPORT_TOOL_ACTIVITY_RECENT_ROW_LIMIT=10000
SHELL_REPORT_DOCKER_LOG_ROOT=/host/docker/containers
SHELL_REPORT_DOCKER_LOG_CONTAINERS=
SHELL_REPORT_DOCKER_LOG_EXTERNAL_CONTAINERS=aawm-litellm,litellm-dev
SHELL_REPORT_ERROR_INTAKE_DIR=/dashboard-shell-analysis
